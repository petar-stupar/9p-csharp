<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Single-target so that "dotnet run" needs no framework switch. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <OutputType>Exe</OutputType>
    <AssemblyName>ninep</AssemblyName>
    <RootNamespace>NineP.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup Label="the test projects that drive this example see its internals">
    <!-- IR-3: the example is a program, so every type in it is internal. These are the
         projects that exercise it, and they are the reason anything here was public. -->
    <InternalsVisibleTo Include="NineP.Client.Tests" />
    <InternalsVisibleTo Include="NineP.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NineP.Client/NineP.Client.csproj" />
  </ItemGroup>

</Project>
